{
  "name": "loopgpt-backend",
  "version": "1.0.0",
  "description": "TheLoopGPT.ai Supabase Backend - Unified backend for MealPlanner, WeightTracker, and future GPT integrations",
  "private": true,
  "scripts": {
    "lint": "deno lint",
    "lint:prod": "./scripts/lint-prod.sh",
    "fmt": "deno fmt --check",
    "fmt:fix": "deno fmt",
    "test": "deno test --allow-all --no-check",
    "typecheck": "deno check supabase/functions/**/*.ts",
    "ci": "npm run lint:prod && npm run fmt && npm run typecheck && npm run test && npm run db:check",
    "deploy:staging": "./scripts/deploy-safe.sh staging",
    "deploy:prod": "./scripts/deploy-safe.sh production",
    "generate-types": "./scripts/generate-types.sh",
    "db:check": "./scripts/db-check.sh",
    "db:migrate": "supabase db push",
    "db:seed": "supabase db reset",
    "db:types": "supabase gen types typescript --local > supabase/functions/_shared/database.types.ts"
  },
  "keywords": [
    "supabase",
    "meal-planning",
    "weight-tracking",
    "mealme",
    "delivery",
    "gpt",
    "ai"
  ],
  "author": "TheLoopGPT.ai",
  "license": "UNLICENSED"
}
